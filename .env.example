# 生产环境必须改成随机长字符串，例如：openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# 与宿主机用户一致，避免 ./data 权限问题（id -u / id -g）
PUID=1000
PGID=1000
UMASK=002

TZ=Asia/Shanghai
LANGUAGE=zh

# 首个管理员账户仍可注册；之后是否允许新用户注册
ACCOUNT_REGISTRATION=false

# 仅在通过 HTTPS 或 localhost 访问时保持 false
HTTP_ALLOWED=false

# 仅在完全可信的内网使用
ALLOW_UNAUTHENTICATED=false

# 每 N 小时清理一次 N 小时前的文件，0 表示禁用
AUTO_DELETE_EVERY_N_HOURS=24

# 反向代理到子路径时取消注释并设置，例如 /convertx
# WEBROOT=/convertx
